{
  "name": "mi-cuatri",
  "version": "0.3.0",
  "description": "Organizador del cuatrimestre (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
